#!/usr/bin/python3 -I
"""ForgeV2 agent launcher: run one ForgeV2 specialist as the forgev2-agent account.

Installed root-owned by the operator (INSTALL.md), never by ForgeV2 itself:
  /usr/local/libexec/forgev2/agent-run       this file, 0755
  /usr/local/libexec/forgev2/roles/*.md       role definitions, 0644
  /etc/sudoers.d/forgev2:
    forgev2-pl ALL=(forgev2-agent) NOPASSWD: /usr/local/libexec/forgev2/agent-run

Usage (forge-dispatch does this):
  sudo -n -u forgev2-agent /usr/local/libexec/forgev2/agent-run ROLE WORKTREE < PROMPT
  sudo -n -u forgev2-agent /usr/local/libexec/forgev2/agent-run --dry-run ROLE WORKTREE

The caller chooses only the role, the Work Order worktree and the prompt. The
Claude command line, environment and working directory are fixed here, and
nothing from the caller's environment is passed on. Every run gets a fresh,
empty HOME, and Claude starts in safe mode without settings, hooks, MCP
servers, skills or CLAUDE.md files, so one specialist cannot leave
configuration behind that a later specialist would load.
"""
import grp
import json
import os
import pwd
import re
import shutil
import signal
import stat
import subprocess
import sys
import tempfile

AGENT, PL, GROUP = "forgev2-agent", "forgev2-pl", "forgev2-work"
CLAUDE = "/usr/local/bin/claude"
HERE = os.path.dirname(os.path.abspath(__file__))
ROLES = ("engineer", "auditor", "tester", "devsecops")
TOOLS = {"Read", "Grep", "Glob", "Edit", "Write", "Bash"}
WO_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")
PATH_RE = re.compile(r"^/[A-Za-z0-9._/-]+$")
MAX_PROMPT = 256 * 1024
TIMEOUT = 1800  # seconds per specialist run
PATH = "/usr/local/bin:/usr/bin:/bin"


class Refused(Exception):
    pass


def root_owned(path):
    st = os.lstat(path)
    if stat.S_ISLNK(st.st_mode) or st.st_uid != 0 or st.st_mode & 0o022:
        raise Refused(f"{path} must be root-owned, not a symlink and not group/world-writable")


def _shared_dir(path, pl_uid, gid):
    st = os.lstat(path)
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != pl_uid or st.st_gid != gid \
            or st.st_mode & 0o2070 != 0o2070 or st.st_mode & 0o002:
        raise Refused(f"{path} must be a directory owned by {PL}, group {GROUP}, mode 2770")


def _pl_only(path, pl_uid, kind):
    st = os.lstat(path)
    if not kind(st.st_mode) or st.st_uid != pl_uid or st.st_mode & 0o022:
        raise Refused(f"{path} must be owned by {PL} and not writable by {GROUP}")


def validate(role, worktree, pl_uid, gid):
    """Return the scratch directory for an acceptable ROLE and WORKTREE, else raise Refused."""
    if role not in ROLES:
        raise Refused(f"unknown role {role!r}")
    if not PATH_RE.match(worktree or "") or os.path.realpath(worktree) != worktree:
        raise Refused("worktree must be an absolute path without symlinks, '..' or unusual characters")
    parent, wo = os.path.split(worktree)
    if os.path.basename(parent) != "worktrees" or not WO_RE.match(wo):
        raise Refused("worktree must be <project>/worktrees/<WO>, as created by forge-start")
    scratch = os.path.join(parent, ".forge-scratch", wo)
    try:
        _pl_only(parent, pl_uid, stat.S_ISDIR)
        _shared_dir(worktree, pl_uid, gid)
        _pl_only(os.path.join(worktree, ".git"), pl_uid, stat.S_ISREG)
        _shared_dir(scratch, pl_uid, gid)
    except OSError as e:
        raise Refused(f"{e.filename}: {e.strerror} (is the project directory traversable by group {GROUP}?)")
    return scratch


def load_role(role, roles_dir):
    path = os.path.join(roles_dir, f"{role}.md")
    root_owned(roles_dir)
    root_owned(path)
    with open(path, encoding="utf-8") as f:
        text = f.read()
    m = re.match(r"^---\n(.*?)\n---\n(.*)$", text, re.S)
    tools = re.search(r"^tools:\s*(.+)$", m.group(1), re.M) if m else None
    if not tools:
        raise Refused(f"{path} has no front matter with a tools: line")
    names = [t.strip() for t in tools.group(1).split(",")]
    if not names or not set(names) <= TOOLS:
        raise Refused(f"{path} lists tools outside {sorted(TOOLS)}")
    return names, m.group(2).strip()


def build(role, worktree, scratch, tools, body, config, home):
    """The fixed Claude command and environment for one specialist run."""
    system = (f"{body}\n\nForgeV2 assignment (set by the launcher): role {role}; worktree {worktree}; "
              f"scratch directory {scratch}. You run as the unprivileged account {AGENT}. The Work Order's "
              "Git metadata, the PL's ledger and the delivery record are not writable by you.")
    t = ",".join(tools)
    argv = [CLAUDE, "-p", "--output-format", "json", "--no-session-persistence", "--safe-mode",
            "--setting-sources", "", "--strict-mcp-config", "--mcp-config", '{"mcpServers":{}}',
            "--disable-slash-commands", "--tools", t, "--allowedTools", t, "--permission-mode", "dontAsk",
            "--add-dir", scratch, "--append-system-prompt", system]
    env = {"PATH": PATH, "HOME": home, "TMPDIR": os.path.join(home, "tmp"), "USER": AGENT, "LOGNAME": AGENT,
           "SHELL": "/bin/bash", "LANG": "C.UTF-8", "CLAUDE_CONFIG_DIR": config,
           "DISABLE_AUTOUPDATER": "1", "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
           # Let the agent's Git read this one PL-owned worktree; it never writes there.
           "GIT_CONFIG_COUNT": "1", "GIT_CONFIG_KEY_0": "safe.directory", "GIT_CONFIG_VALUE_0": worktree,
           "FORGE_ROLE": role, "FORGE_WORKTREE": worktree, "FORGE_SCRATCH": scratch}
    return argv, env


def run(argv, env, cwd, prompt, home):
    os.mkdir(env["TMPDIR"], 0o700)
    os.umask(0o002)
    p = subprocess.Popen(argv, cwd=cwd, env=env, stdin=subprocess.PIPE, start_new_session=True)

    def stop(*_):
        for sig in (signal.SIGTERM, signal.SIGKILL):
            try:
                os.killpg(p.pid, sig)
            except ProcessLookupError:
                return
            try:
                p.wait(timeout=10)
            except subprocess.TimeoutExpired:
                pass

    def on_signal(signum, _):
        stop()
        sys.exit(128 + signum)

    for s in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(s, on_signal)
    try:
        p.communicate(prompt, timeout=TIMEOUT)
        return p.returncode
    except subprocess.TimeoutExpired:
        print(f"agent-run: specialist exceeded {TIMEOUT}s and was stopped", file=sys.stderr)
        return 124
    finally:
        stop()  # also ends anything the specialist left running in its process group
        shutil.rmtree(home, ignore_errors=True)


def main(args):
    dry = args[:1] == ["--dry-run"]
    if dry:
        args = args[1:]
    if len(args) != 2:
        raise Refused("usage: agent-run [--dry-run] ROLE WORKTREE < PROMPT")
    role, worktree = args
    me = pwd.getpwuid(os.getuid())
    if me.pw_name != AGENT or os.geteuid() != os.getuid():
        raise Refused(f"must run as {AGENT} (sudo -u {AGENT}), not {me.pw_name}")
    root_owned(HERE)
    root_owned(os.path.abspath(__file__))
    root_owned(CLAUDE)
    root_owned(os.path.dirname(CLAUDE))
    scratch = validate(role, worktree, pwd.getpwnam(PL).pw_uid, grp.getgrnam(GROUP).gr_gid)
    tools, body = load_role(role, os.path.join(HERE, "roles"))
    config = os.path.join(me.pw_dir, ".claude")
    if not os.path.isdir(config):
        raise Refused(f"{AGENT} has no Claude login ({config} missing); see INSTALL.md")
    if dry:
        argv, env = build(role, worktree, scratch, tools, body, config, "/tmp/forgev2-<role>-<random>")
        json.dump({"argv": argv, "env": env, "cwd": worktree}, sys.stdout, indent=2)
        print()
        return 0
    prompt = sys.stdin.buffer.read(MAX_PROMPT + 1)
    if len(prompt) > MAX_PROMPT or not prompt.strip():
        raise Refused(f"the prompt on stdin must be 1 to {MAX_PROMPT} bytes")
    prompt.decode("utf-8")
    home = tempfile.mkdtemp(prefix=f"forgev2-{role}-", dir="/tmp")
    argv, env = build(role, worktree, scratch, tools, body, config, home)
    return run(argv, env, worktree, prompt, home)


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except (Refused, UnicodeDecodeError, KeyError) as e:
        print(f"agent-run: refused: {e}", file=sys.stderr)
        sys.exit(2)
