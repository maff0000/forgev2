#!/usr/bin/env python3
"""forge-start: verify repository identity, create the WO branch/worktree, open the ledger.

Usage: forge-start --wo ID --repo OWNER/NAME --root PROJECT_ROOT [--base BRANCH]
                   [--known-commit SHA] [--worktrees DIR]
Re-running for an existing Work Order resumes it; execution counts are never reset.
The ledger is kept in the PL's private state directory, outside the worktree.
"""
import argparse
import os, sys
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))
import forgelib as F  # noqa: E402


def main():
    a = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    a.add_argument("--wo", required=True)
    a.add_argument("--repo", required=True)
    a.add_argument("--root", required=True)
    a.add_argument("--base", default="main")
    a.add_argument("--known-commit")
    a.add_argument("--worktrees")
    o = a.parse_args()
    root_override = F.require_non_root()
    if not F.WO_RE.match(o.wo):
        raise F.ForgeError(f"invalid Work Order id {o.wo!r}")
    facts = F.check_repo(o.root, o.repo, o.known_commit)
    root = facts["root"]
    branch = f"forge/{o.wo}"
    wt_parent = os.path.realpath(o.worktrees or os.path.join(os.path.dirname(root), "worktrees"))
    wt = os.path.join(wt_parent, o.wo)
    ledger = F.ledger_path(root, o.wo)
    if os.path.exists(ledger):
        with F.locked_ledger(ledger, write=False) as d:
            if (d["repo"], d["root"], d["worktree"], d["wo"]) != (facts["repo"], root, wt, o.wo):
                raise F.ForgeError("existing ledger belongs to a different repository or worktree")
            if not os.path.isdir(wt):
                raise F.ForgeError(f"ledger exists but worktree {wt} is missing; use a new Work Order id")
        resumed = True
    else:
        if os.path.lexists(wt):
            raise F.ForgeError(f"{wt} exists but has no ForgeV2 ledger; refusing to reuse it")
        base_sha = F.git("rev-parse", "--verify", f"{o.base}^{{commit}}", cwd=root)
        if F.git_run("cat-file", "-e", f"{base_sha}:.forge/{o.wo}", cwd=root).returncode == 0:
            raise F.ForgeError(f"base already contains records for {o.wo}; use a new Work Order id")
        if F.git("rev-parse", "--verify", "--quiet", f"refs/heads/{branch}", cwd=root, check=False):
            raise F.ForgeError(f"branch {branch} already exists without a ledger; resolve manually")
        try:
            os.makedirs(wt_parent, exist_ok=True)
            scratch = os.path.join(wt_parent, ".forge-scratch", o.wo)
            os.makedirs(scratch, mode=0o700, exist_ok=True)
        except OSError as e:
            raise F.ForgeError(f"cannot create the worktree area {wt_parent}: {e}")
        F.git("worktree", "add", "-q", "-b", branch, wt, base_sha, cwd=root)
        # Record the worktree's Git directory now, while it is known-good; later
        # operations never read the worktree's own `.git` pointer file.
        git_dir = os.path.realpath(F.git("rev-parse", "--absolute-git-dir", cwd=wt))
        if os.path.dirname(git_dir) != os.path.join(facts["common_dir"], "worktrees"):
            raise F.ForgeError(f"unexpected worktree Git directory {git_dir}")
        d = F.new_ledger(o.wo, facts, wt, git_dir, branch, o.base, base_sha, o.known_commit, scratch)
        if root_override:
            d["events"].append({"t": F.now(), "type": "root_override", "uid": 0})
        F.write_new_ledger(ledger, d)
        resumed = False
    with F.locked_ledger(ledger, write=False) as d:
        # Distinguishing check: the worktree must carry the project's own history.
        probe = d["known_commit"] or d["base_sha"]
        if F.wgit(d, "cat-file", "-t", probe, check=False) != "commit":
            raise F.ForgeError("worktree does not resolve the project's history; it is not of this repository")
        if F.wgit(d, "branch", "--show-current") != branch:
            raise F.ForgeError(f"worktree is not on {branch}")
        session = os.environ.get("CLAUDE_CODE_SESSION_ID", "")
        if session:
            F.bind_session(session, ledger)
        F.emit({"resumed": resumed, "worktree": wt, "branch": branch, "ledger": ledger,
                "session_bound": bool(session), "counts": d["counts"], "limit": F.LIMIT,
                "scratch": d["scratch"], "base_sha": d["base_sha"], "candidate": d["candidate"],
                "decision": F.decide(d)[0], "root_override": root_override})


if __name__ == "__main__":
    try:
        main()
    except F.ForgeError as e:
        print(f"forge-start: REJECTED: {e}", file=sys.stderr)
        sys.exit(1)
